# GigaChat prototype credentials. Never commit a real .env file.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_CORP
GIGACHAT_MODEL=GigaChat-2-Max

# Intentionally disabled for the agreed local prototype only.
# Production deployments must enable TLS verification and configure a CA bundle.
GIGACHAT_VERIFY_SSL_CERTS=false
GIGACHAT_TIMEOUT_SECONDS=30

TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEOUT_SECONDS=30
STATE_DB_PATH=var/agent.db

LOG_LEVEL=INFO
LOG_FILE_PATH=var/logs/agent.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

SCORE_CSV_PATH=resources/sample_scores_table_auto_349653.csv
FEATURE_MAPPING_PATH=resources/feature_mappings.json
